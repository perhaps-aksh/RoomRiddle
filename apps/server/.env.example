# Room Riddle server settings. Copy to apps/server/.env (git-ignored) and fill in.
# Every value is optional: with nothing set, the game runs fully offline with
# authored suspect lines and subtitles only. Real environment variables win.

# --- Network ---------------------------------------------------------------
# PORT=4000
# HOST=0.0.0.0
# Base URL phones use for join links and the QR code (auto-detected LAN IP if unset).
# PUBLIC_URL=http://192.168.1.20:4000

# --- AI suspects (free tiers) -----------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional second provider (Google AI Studio key).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# AI_ORDER=groq,gemini
# 1 = authored lines only (offline demo).
# AI_DISABLED=1
# AI_TIMEOUT_MS=6000
# AI_MAX_QUESTIONS=30
# AI_COOLDOWN_MS=4000

# --- Voices -------------------------------------------------------------------
# Edge neural voices need no key; Groq Orpheus uses GROQ_API_KEY (accept the model
# terms once in the Groq console). The TV needs ffmpeg on the server to stream clips.
# VOICE_ORDER=edge,groq
# VOICES_DISABLED=1
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Rooms --------------------------------------------------------------------
# ROOM_MIN_PLAYERS=2
# ROOM_MAX_PLAYERS=6
# MAX_ROOMS=200
# LOBBY_PLAYER_GRACE_MS=120000
# HOST_GRACE_MS=600000
