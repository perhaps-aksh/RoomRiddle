{
  "name": "@roomriddle/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative RoomRiddle game server: rooms, players, sessions and game state over WebSockets; also serves the phone app.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
