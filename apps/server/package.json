    "play-bots": "tsx scripts/play-bots.ts",
    "ai-smoke": "tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@roomriddle/client": "*",
    "@roomriddle/game-engine": "*",
    "@roomriddle/scene": "*",
    "@roomriddle/mystery-data": "*",
    "@roomriddle/shared-types": "*",
    "msedge-tts": "^2.0.9",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
